# Loaded by `pnpm start:served` via node's --env-file. Mirrors the hosted
# setup from Step 9: one process, one port, serving the built site itself.
NODE_ENV=development
PORT=3102
WEB_ORIGIN=http://localhost:3102
DATABASE_URL=file:./data/served.db
JWT_SECRET=arena-served-jwt-secret

# As in .env.e2e: the suite signs up repeatedly from one address.
SIGNUP_RATE_LIMIT=10000
LOGIN_RATE_LIMIT=10000

# Same test deposit settings as .env.e2e; the browser tests write the file.
USDT_ADDRESS_TRC20=TBXSw8fM4jpQkGc6zZjsVABFpVN7UvXPdV
USDT_ADDRESS_BEP20=0x1111111111111111111111111111111111111111
DEPOSIT_CHAIN_FAKE_FILE=./data/e2e-chain.json
