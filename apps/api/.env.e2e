# Loaded by `pnpm start:e2e` via node's --env-file, so the Playwright run can
# never fall back to the development database or the development port.
NODE_ENV=development
PORT=3101
WEB_ORIGIN=http://localhost:5174
DATABASE_URL=file:./data/e2e.db
JWT_SECRET=arena-e2e-jwt-secret

# The whole suite signs up from one address, which is exactly what the
# production limits exist to stop. Lift them here so they do not mask failures.
SIGNUP_RATE_LIMIT=10000
LOGIN_RATE_LIMIT=10000
