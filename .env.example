# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# The origin CORS allows, and the only one it allows.
#   development: the Vite dev server, which proxies /api and /socket.io here
#   hosted:      the public URL, because the API serves the site itself
WEB_ORIGIN=http://localhost:5173

# Optional. Where the built site is read from. Defaults to apps/web/dist,
# resolved relative to the API source, so it works from any working directory.
# The API starts without a bundle and serves the API alone.
# WEB_DIST=/srv/arena/apps/web/dist

# SQLite file for this hosted-RAC goal. Postgres stays unused.
DATABASE_URL=file:./data/game.db
JWT_SECRET=replace-with-a-long-random-string

# Set when a tunnel or reverse proxy terminates TLS in front of the app.
# Without it the rate limiter sees the proxy's address, not the caller's.
TRUST_PROXY=false

# Signup hands out 100 RAC, so it is capped per client address per hour.
# Everyone behind one router counts as one client; raise it for a test session
# where your players share a network. Logins are capped per minute.
SIGNUP_RATE_LIMIT=10
LOGIN_RATE_LIMIT=20

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Wired in later steps. The shell starts without these.
REDIS_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SENTRY_DSN=

# Web
VITE_SENTRY_DSN=
