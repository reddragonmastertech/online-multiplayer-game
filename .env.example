# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# The origin CORS allows, and the only one it allows.
#   development: the Vite dev server, which proxies /api and /socket.io here
#   hosted:      the public URL, because the API serves the site itself
WEB_ORIGIN=http://localhost:5173

# Optional. Where the built site is read from. Defaults to apps/web/dist,
# resolved relative to the API source, so it works from any working directory.
# The API starts without a bundle and serves the API alone.
# WEB_DIST=/srv/arena/apps/web/dist

# SQLite file for this hosted-RAC goal. Postgres stays unused.
DATABASE_URL=file:./data/game.db
JWT_SECRET=replace-with-a-long-random-string

# Set when a tunnel or reverse proxy terminates TLS in front of the app.
# Without it the rate limiter sees the proxy's address, not the caller's.
TRUST_PROXY=false

# Signup hands out 100 RAC, so it is capped per client address per hour.
# Everyone behind one router counts as one client; raise it for a test session
# where your players share a network. Logins are capped per minute.
SIGNUP_RATE_LIMIT=10
LOGIN_RATE_LIMIT=20

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional. Error reporting to Sentry; leave empty to turn it off.
SENTRY_DSN=

# USDT deposits. Your receiving address per network; a network left empty
# stays closed in the Top Up dialog. Checked on startup: a malformed address
# stops the server rather than taking money to the wrong place.
USDT_ADDRESS_TRC20=
USDT_ADDRESS_BEP20=
USDT_ADDRESS_ERC20=

# Optional. Where deposits are read from. The defaults are free public
# endpoints; a provider URL (Alchemy, Infura, QuickNode, ...) is more reliable.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# TRONGRID_URL=https://api.trongrid.io
# TRONGRID_API_KEY=

# Optional. Daily backups: where they go (default: a `backups` folder next to
# the database) and how many to keep.
# BACKUP_DIR=
# BACKUP_KEEP=14

# Optional. Withdrawal limits in whole USDT; 0 turns one off. A second
# approval only applies while two or more admins can pay withdrawals.
# WITHDRAWAL_DAILY_LIMIT=1000
# WITHDRAWAL_SECOND_APPROVAL=500

# Web
VITE_SENTRY_DSN=
